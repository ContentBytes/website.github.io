---
interface Props {
  items: string[];
  align?: "left" | "center";
}

const { items, align = "center" } = Astro.props;
---

<ul class:list={["square-list", align]}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .square-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .left   { justify-content: flex-start; }
  .center { justify-content: center; }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  li::before {
    content: "";
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    background-color: var(--main-green);
  }
</style>